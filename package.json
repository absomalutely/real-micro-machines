{
  "name": "real-micro-machines",
  "private": true,
  "version": "0.1.0",
  "description": "Micro Machines-style 3D arcade racer with real-world road data",
  "scripts": {
    "dev": "pnpm --filter client dev",
    "build": "pnpm --filter client build",
    "test": "pnpm --filter client test",
    "test:e2e": "pnpm --filter client test:e2e",
    "lint": "pnpm --filter client lint",
    "typecheck": "pnpm --filter client typecheck"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "lefthook",
      "msgpackr-extract"
    ]
  },
  "devDependencies": {
    "lefthook": "^2.1.3"
  }
}
